
ty Stack _origin, _element
    # a singly-linked list. Since it is backed by a vec,
    # adjacent nodes are likely close together in memory. Who doesn't love that.
    # (note that it's still noticeably worse than a simple vec most of the time)
    |empty .
    |stacked .head _element .tail Slot _origin

fn stack-cons
    .nodes nodes Vec _origin, Stack _origin, _element
    .stack tail Stack _origin, _element
    .new new-head _element
    :>
    .nodes Vec _origin, Stack _origin, _element
    .stack Stack _origin, _element
    >
    ? _vec-insert .vec nodes .new tail [.vec nodes .slot tail-slot]
    .nodes nodes
    .stack (|stacked<Stack _origin, _element> .head new-head .tail tail-slot)

fn stack-pop
    .nodes nodes Vec _origin, Stack _origin, _element
    .stack stack Stack _origin, _element
    :>
    .nodes Vec _origin, Stack _origin, _element
    .element (
        Opt
        .head _element
        .tail Stack _origin, _element
        )
    >
    ? stack
    [|empty .]
        .nodes nodes
        .element
            |no<
                Opt
                .head _element
                .tail Stack _origin, _element
                >
            .
    [|stacked .head head .tail tail-slot] (
        ? _vec-remove .vec nodes .slot tail-slot [.vec nodes .element tail]
        .nodes nodes
        .element (_opt-yes .head head .tail tail)
        )

fn stack-fold
    .nodes nodes Vec _origin, Stack _origin, _element
    .stack stack Stack _origin, _element
    .state state _state
    .reduce reduce Fn .state _state .element _element, _state
    :>
    .nodes Vec _origin, Stack _origin, _element
    .state _state
    >
    ? stack
    [|empty .] (
        ? _fn-rid reduce [.]
        .nodes nodes .state state
        )
    [|stacked .head head .tail tail-slot]
    ? _vec-remove .vec nodes .slot tail-slot [.vec nodes .element tail]
    ? _fn-dup reduce [.a reduce-a .b reduce-b]
    ? _reduce-a .state state .element head [elements-nodes]
    _stack-fold
    .nodes nodes
    .stack tail
    .reduce reduce-b
    .state elements-nodes

fn example . :> u32 >
    origin example-stack-origin
    ?
        .nodes _vec-empty<Stack example-stack-origin, u32> example-stack-origin
        .stack |empty<Stack example-stack-origin, u32> .
    [example-stack]
    ? _stack-cons .. example-stack .new 39 u32 [example-stack]
    ? _stack-cons .. example-stack .new 3 u32 [example-stack]
    ?
        _stack-fold
        .. example-stack
        .state 0 u32
        .reduce (
            [.state state u32 .element element u32]
            _u32-add-clamp .a state .b element
            )
    [.nodes example-stack-nodes .state result]
    ? _vec-rid example-stack-nodes [.]
    result

