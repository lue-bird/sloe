
ty Stack _origin, _element
    # a singly-linked list. Since it is backed by a buf,
    # adjacent nodes are likely close together in memory. Who doesn't love that.
    # (note that it's still noticeably worse than a simple buf most of the time)
    |empty .
    |stacked .head _element .tail Slot _origin

fn Stack-cons
    .nodes nodes Buf _origin, Stack _origin, _element
    .stack tail Stack _origin, _element
    .new new-head _element
    :
    .nodes Buf _origin, Stack _origin, _element
    .stack Stack _origin, _element
    =
    ? Buf-insert .buf nodes .new tail [.buf nodes .slot tail-slot]
    .nodes nodes
    .stack (|{Stack _origin, _element}stacked .head new-head .tail tail-slot)

fn Stack-pop
    .nodes nodes Buf _origin, Stack _origin, _element
    .stack stack Stack _origin, _element
    :
    .nodes Buf _origin, Stack _origin, _element
    .element (
        Opt
        .head _element
        .tail Stack _origin, _element
        )
    =
    ? stack
    [|empty .]
        .nodes nodes
        .element
            |{
            Opt
            .head _element
            .tail Stack _origin, _element
            }
            no
            .
    [|stacked .head head .tail tail-slot] (
        ? Buf-remove .buf nodes .slot tail-slot [.buf nodes .element tail]
        .nodes nodes
        .element (Opt-yes .head head .tail tail)
        )

fn Stack-fold
    .nodes nodes Buf _origin, Stack _origin, _element
    .stack stack Stack _origin, _element
    .state state _state
    .reduce reduce Fn .state _state .element _element, _state
    :
    .nodes Buf _origin, Stack _origin, _element
    .state _state
    =
    ? stack
    [|empty .] (
        ? Fn-rid reduce [.]
        .nodes nodes .state state
        )
    [|stacked .head head .tail tail-slot]
    ? Buf-remove .buf nodes .slot tail-slot [.buf nodes .element tail]
    ? Fn-dup reduce [.a reduce-a .b reduce-b]
    ? Call .fn reduce-a .in (.state state .element head) [elements-nodes]
    Stack-fold
    .nodes nodes
    .stack tail
    .reduce reduce-b
    .state elements-nodes

fn Example . : u32 =
    ^example-origin
    ?
        .nodes Buf-empty{Stack (Origin-part example-origin, .example-origin .), u32} example-origin
        .stack |{Stack (Origin-part example-origin, .example-origin .), u32}empty .
    [example-stack]
    ? Stack-cons .. example-stack .new 39 u32 [example-stack]
    ? Stack-cons .. example-stack .new 3 u32 [example-stack]
    ?
        Stack-fold
        .. example-stack
        .state 0 u32
        .reduce (
            [.state state u32 .element element u32]
            U32-add-clamp .a state .b element
            )
    [.nodes example-stack-nodes .state result]
    ? Buf-rid example-stack-nodes [.]
    result

