    :linked-list
    Empty & (& backing backing elements-backing elements-backing)
    (Cons & head head tail tail-slot)
        (:(vec-element & vec backing slot tail-slot) (& vec backing element tail) <
            :(fn-dup vacate-element) (& a vacate-element-a b vacate-element-b) <
            :(vacate-element-a elements-backing head) elements-backing <
