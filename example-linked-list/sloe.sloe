
ty stack Origin, Element
    # a singly-linked list. Since it is backed by a vec,
    # adjacent nodes are likely close together in memory. Who doesn't love that.
    # (note that it's still noticeably worse than a simple vec most of the time)
    |empty .
    |stacked .head Element .tail _slot Origin

fn stack-cons
    .nodes nodes _vec Origin, _stack Origin, Element
    .stack tail _stack Origin, Element
    .new new-head Element
    :>
    .nodes _vec Origin, _stack Origin, Element
    .stack _stack Origin, Element
    >
    ? _vec-insert .vec nodes .new tail [.vec nodes .slot tail-slot]
    .nodes nodes
    .stack (|stacked<_stack Origin, Element> .head new-head .tail tail-slot)

fn stack-pop
    .nodes nodes _vec Origin, _stack Origin, Element
    .stack stack _stack Origin, Element
    :>
    .nodes _vec Origin, _stack Origin, Element
    .element (
        _opt
        .head Element
        .tail _stack Origin, Element
        )
    >
    ? stack
    [|empty .]
        .nodes nodes
        .element
            |no<
                _opt
                .head Element
                .tail _stack Origin, Element
                >
            .
    [|stacked .head head .tail tail-slot] (
        ? _vec-remove .vec nodes .slot tail-slot [.vec nodes .element tail]
        .nodes nodes
        .element (_opt-yes .head head .tail tail)
        )

fn stack-fold
    .nodes nodes _vec Origin, _stack Origin, Element
    .stack stack _stack Origin, Element
    .state state State
    .reduce reduce _fn .state State .element Element, State
    :>
    .nodes _vec Origin, _stack Origin, Element
    .state State
    >
    ? stack
    [|empty .] (
        ? _fn-rid reduce [.]
        .nodes nodes .state state
        )
    [|stacked .head head .tail tail-slot]
    ? _vec-remove .vec nodes .slot tail-slot [.vec nodes .element tail]
    ? _fn-dup reduce [.a reduce-a .b reduce-b]
    ? _reduce-a .state state .element head [elements-nodes]
    _stack-fold
    .nodes nodes
    .stack tail
    .reduce reduce-b
    .state elements-nodes

fn example . :> u32 >
    origin example-stack-origin
    ?
        .nodes _vec-empty<_stack example-stack-origin, u32> example-stack-origin
        .stack |empty<_stack example-stack-origin, u32> .
    [example-stack]
    ? _stack-cons .. example-stack .new 39 u32 [example-stack]
    ? _stack-cons .. example-stack .new 3 u32 [example-stack]
    ?
        _stack-fold
        .. example-stack
        .state 0 u32
        .reduce (
            [.state state u32 .element element u32]
            _u32-add-clamp .a state .b element
            )
    [.nodes example-stack-nodes .state result]
    ? _vec-rid example-stack-nodes [.]
    result

