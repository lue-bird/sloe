
fn greet
    .name name str .result-origin result-origin _origin Origin
    :> _opt-span-build _vec Origin, char >
    ? _vec-span-empty _vec-empty<char> result-origin = build >
    ? _vec-opt-span-add-str .build build .new "Hello, " = build >
    ? _vec-opt-span-add-str .build build .new name = build >
    _vec-opt-span-add-str .build build .new "!\n"

