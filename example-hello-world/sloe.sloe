
fn greet
    .name name str .result-origin result-origin Origin _origin
    :> .vec Vec _origin, char .span Opt Span _origin >
    ? .vec _vec-empty<char> result-origin .span |no<Opt Span _origin> . [string]
    ? _vec-char-opt-span-add-str .. string .new "Hello, " [string]
    ? _vec-char-opt-span-add-str .. string .new name [string]
    _vec-char-opt-span-add-str .. string .new "!\n"

