
ty state
    .count u32
    .mouse-x u32
    .mouse-y u32
    .mouse-trail Origin-erased Mouse-trail-origin-erased .

ty Mouse-trail _origin
    .buf (Buf _origin, .x u32 .y u32)
    .span Opt Span _origin

ty Mouse-trail-origin-erased _part
    .buf (Buf-origin-erased _part, .x u32 .y u32)
    .span Opt Span Origin erased, _part

ty event
    'counter-clicked .
    'mouse-moved .x u32 .y u32

fn Initial-state . : state =
    ^mouse-trail-origin
    .count 0 u32
    .mouse-x 0 u32
    .mouse-y 0 u32
    .mouse-trail (
        Origin-erase
        Mouse-trail-origin-isolate
        .buf Buf-empty{.x u32 .y u32} mouse-trail-origin
        .span 'no{Opt Span Origin mouse-trail-origin, .} .
        )

fn Mouse-trail-origin-isolate
    mouse-trail Mouse-trail Origin _origin, _part
    : Origin-isolated _origin, Mouse-trail-origin-erased _part =
    ? mouse-trail [.buf buf .span span]
    Origin-isolated-map
    .change (
        [.a (buf Buf-origin-erased _part, .x u32 .y u32) .b span Opt Span Origin erased, _part]
        .buf buf .span span
        )
    .isolated
    Origin-isolated-merge
    .a (
        Buf-origin-isolate
        .buf buf
        .item-isolate
        [.x x u32 .y y u32]
        Origin-isolated-map
        .change ([.a x u32 .b y u32] .x x .y y)
        .isolated
        Origin-isolated-merge
        .a U32-origin-isolate{_origin} x
        .b U32-origin-isolate{_origin} y
        )
    .b Opt-span-origin-isolate span

fn Mouse-trail-origin-unerase
    .erased erased Mouse-trail-origin-erased _part
    .uneraser uneraser Origin-uneraser _origin
    :
    .unerased Mouse-trail Origin _origin, _part
    .uneraser Origin-uneraser _origin
    =
    ? erased [.buf buf .span span]
    ? Buf-origin-unerase-keep-items .buf buf .uneraser uneraser
    [.buf buf .uneraser uneraser]
    ? Opt-span-origin-unerase .span span .uneraser uneraser
    [.span span .uneraser uneraser]
    .unerased (.buf buf .span span) .uneraser uneraser

fn Update
    .state state state
    .event event event
    : state =
    ? event
    ['counter-clicked .] (
        ? state [.count count .mouse-x old-mouse-x .mouse-y old-mouse-y .mouse-trail mouse-trail]
        .count (U32-add-clamp .a count .b 1 u32)
        .mouse-x old-mouse-x
        .mouse-y old-mouse-y
        .mouse-trail mouse-trail
        )
    ['mouse-moved .x new-mouse-x .y new-mouse-y] (
        ? state [.count count .mouse-x old-mouse-x .mouse-y old-mouse-y .mouse-trail mouse-trail]
        ^mouse-trail-origin
        ?
            Origin-unerase
            .erased mouse-trail
            .origin mouse-trail-origin
            .unerase
            [
            .erased mouse-trail Mouse-trail-origin-erased .
            .uneraser uneraser Origin-uneraser mouse-trail-origin
            ]
            Mouse-trail-origin-unerase .erased mouse-trail .uneraser uneraser
        [mouse-trail]
        ?
            Buf-opt-span-add
            .. mouse-trail .new (.x old-mouse-x .y old-mouse-y)
        [.buf mouse-trail .span mouse-trail-span]
        .count count
        .mouse-x new-mouse-x
        .mouse-y new-mouse-y
        .mouse-trail (
            Origin-erase
            Mouse-trail-origin-isolate
            .buf mouse-trail .span 'yes{'no .} mouse-trail-span
            )
        )

fn View
    .state state state
    .htmls htmls Buf (Origin _view, .html .), Html _view
    .modifiers
        modifiers Buf (Origin _view, .modifier .), Modifier event, _view
    .chars chars Buf (Origin _view, .char .), char
    :
    .state state
    .html Html _view
    .htmls Buf (Origin _view, .html .), Html _view
    .modifiers
        Buf (Origin _view, .modifier .), Modifier event, _view
    .chars Buf (Origin _view, .char .), char
    =
    ? state [.count count .mouse-x mouse-x .mouse-y mouse-y .mouse-trail mouse-trail]
    ? .buf chars .span 'no{Opt Span Origin _view, .char .} . [text]
    ? Buf-char-opt-span-add-str .. text .new "your mouse is at .x " str [text]
    ? U32-dup mouse-x [.a mouse-x .b mouse-x-use]
    ? Buf-char-span-add-u32 .. text .new mouse-x-use [text]
    ? Buf-char-span-add-str .. text .new " .y " str [text]
    ? U32-dup mouse-y [.a mouse-y .b mouse-y-use]
    ? Buf-char-span-add-u32 .. text .new mouse-y-use [.buf chars .span text-span]
    ?
        Buf-add-array
        .buf htmls
        .new
            ; 'text-dynamic{Html _view} 'yes{'no .} text-span
            ; 'text-static{Html _view} "hello" str
    [.buf htmls .span div-subs]
    ?
        Buf-add-array
        .buf modifiers
        .new
            ; 'style-static{Modifier event, _view} .key "height" str .value "100vh" str
            ; 'style-static{Modifier event, _view} .key "width" str .value "100vw" str
            ;
                'on-mouse-move{Modifier event, _view}
                [mouse-position .x u32 .y u32] 'mouse-moved{event} mouse-position
    [.buf modifiers .span main-modifiers]
    .state (.count count .mouse-x mouse-x .mouse-y mouse-y .mouse-trail mouse-trail)
    .html (
        'element{Html _view}
        .tag "main" str
        .modifiers 'yes{'no .} main-modifiers
        .subs 'yes{'no .} div-subs
        )
    .htmls htmls
    .modifiers modifiers
    .chars chars

ty Html _view
    # for namespace, use xmlns attribute
    'element
        .tag str
        .modifiers (Opt Span Origin _view, .modifier .)
        .subs (Opt Span Origin _view, .html .)
    'text-dynamic Opt Span Origin _view, .char .
    'text-static str

ty Modifier _event, _view
    'style-static .key str .value str
    'style-dynamic .key str .value (Opt Span Origin _view, .char .)
    'attribute-static .key str .value str
    'attribute-dynamic .key str .value (Opt Span Origin _view, .char .)
    'property .key str .value (Modifier-property-value Origin _view, .char .)
    'on-mouse-move Fn .x u32 .y u32, _event

ty Modifier-property-value _chars
    'true .
    'false .
    'int i32
    'string Opt Span _chars
