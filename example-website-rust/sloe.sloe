
ty State _mouse-trail-origin
    .count u32
    .mouse-x u32
    .mouse-y u32
    .mouse-trail (Buf _mouse-trail-origin, .x u32 .y u32)
    .mouse-trail-span Opt Span _mouse-trail-origin

ty event
    |counter-clicked .
    |mouse-moved .x u32 .y u32

fn Initial-state mouse-trail-origin Origin _mouse-trail-origin : State _mouse-trail-origin =
    .count 0 u32
    .mouse-x 0 u32
    .mouse-y 0 u32
    .mouse-trail Buf-empty{.x u32 .y u32} mouse-trail-origin
    .mouse-trail-span |{Opt Span _mouse-trail-origin}no .

fn Update
    .state state State _mouse-trail-origin
    .event event event
    : State _mouse-trail-origin =
    ? event
    [|counter-clicked .] (
        ? state [.count count .mouse-x old-mouse-x .mouse-y old-mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span]
        .count (U32-add-clamp .a count .b 1 u32)
        .mouse-x old-mouse-x
        .mouse-y old-mouse-y
        .mouse-trail mouse-trail
        .mouse-trail-span mouse-trail-span
        )
    [|mouse-moved .x new-mouse-x .y new-mouse-y] (
        ? state [.count count .mouse-x old-mouse-x .mouse-y old-mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span]
        ?
            Buf-opt-span-add
            .buf mouse-trail
            .span mouse-trail-span
            .new (.x old-mouse-x .y old-mouse-y)
        [.buf mouse-trail .span mouse-trail-span]
        .count count
        .mouse-x new-mouse-x
        .mouse-y new-mouse-y
        .mouse-trail mouse-trail
        .mouse-trail-span Opt-yes mouse-trail-span
        )

fn View
    .state state State _mouse-trail-origin
    .htmls htmls Buf (Origin-part _view, .html .), Html _view
    .modifiers
        modifiers Buf (Origin-part _view, .modifier .), Modifier event, _view
    .chars chars Buf (Origin-part _view, .char .), char
    :
    .state State _mouse-trail-origin
    .html Html _view
    .htmls Buf (Origin-part _view, .html .), Html _view
    .modifiers
        Buf (Origin-part _view, .modifier .), Modifier event, _view
    .chars Buf (Origin-part _view, .char .), char
    =
    ? state [.count count .mouse-x mouse-x .mouse-y mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span]
    ? .buf chars .span |{Opt Span Origin-part _view, .char .}no . [text]
    ? Buf-char-opt-span-add-str .. text .new "your mouse is at .x " [text]
    ? U32-dup mouse-x [.a mouse-x .b mouse-x-use]
    ? Buf-char-span-add-u32 .. text .new mouse-x-use [text]
    ? Buf-char-span-add-str .. text .new " .y " [text]
    ? U32-dup mouse-y [.a mouse-y .b mouse-y-use]
    ? Buf-char-span-add-u32 .. text .new mouse-y-use [.buf chars .span text-span]
    ?
        Buf-add-array
        .buf htmls
        .new
            ; |{Html _view}text-dynamic Opt-yes text-span
            ; |{Html _view}text-static "hello"
    [.buf htmls .span div-subs]
    ?
        Buf-add-array
        .buf modifiers
        .new
            ; |{Modifier event, _view}style-static .key "height" .value "100vh"
            ; |{Modifier event, _view}style-static .key "width" .value "100vw"
            ;
                |{Modifier event, _view}on-mouse-move
                [mouse-position .x u32 .y u32] |{event}mouse-moved mouse-position
    [.buf modifiers .span main-modifiers]
    .state (.count count .mouse-x mouse-x .mouse-y mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span)
    .html (
        |{Html _view}element
        .tag "main"
        .modifiers Opt-yes main-modifiers
        .subs Opt-yes div-subs
        )
    .htmls htmls
    .modifiers modifiers
    .chars chars

ty Html _view
    # for namespace, use xmlns attribute
    |element
        .tag str
        .modifiers (Opt Span Origin-part _view, .modifier .)
        .subs (Opt Span Origin-part _view, .html .)
    |text-dynamic Opt Span Origin-part _view, .char .
    |text-static str

ty Modifier _event, _view
    |style-static .key str .value str
    |style-dynamic .key str .value (Opt Span Origin-part _view, .char .)
    |attribute-static .key str .value str
    |attribute-dynamic .key str .value (Opt Span Origin-part _view, .char .)
    |property .key str .value (Modifier-property-value Origin-part _view, .char .)
    |on-mouse-move Fn .x u32 .y u32, _event

ty Modifier-property-value _chars
    |true .
    |false .
    |int i32
    |string Opt Span _chars

