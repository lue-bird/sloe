
ty state Mouse-trail-origin
    .count u32
    .mouse-x u32
    .mouse-y u32
    .mouse-trail (_vec Mouse-trail-origin, .x u32 .y u32)
    .mouse-trail-span _opt _span Mouse-trail-origin

ty event
    |counter-clicked .
    |mouse-moved .x u32 .y u32

fn initial-state mouse-trail-origin _origin Mouse-trail-origin :> _state Mouse-trail-origin >
    .count 0 u32
    .mouse-x 0 u32
    .mouse-y 0 u32
    .mouse-trail _vec-empty<.x u32 .y u32> mouse-trail-origin
    .mouse-trail-span |absent<_opt _span Mouse-trail-origin> .

fn update
    .state state _state Mouse-trail-origin
    .event event event
    :> _state Mouse-trail-origin >
    ? event
    [|counter-clicked .] (
        ? state [.count count .mouse-x old-mouse-x .mouse-y old-mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span]
        .count (_u32-add-clamp .a count .b 1 u32)
        .mouse-x old-mouse-x
        .mouse-y old-mouse-y
        .mouse-trail mouse-trail
        .mouse-trail-span mouse-trail-span
        )
    [|mouse-moved .x new-mouse-x .y new-mouse-y] (
        ? state [.count count .mouse-x old-mouse-x .mouse-y old-mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span]
        ?
            _vec-opt-span-add
            .vec mouse-trail
            .span mouse-trail-span
            .new (.x old-mouse-x .y old-mouse-y)
        [.vec mouse-trail .span mouse-trail-span]
        .count count
        .mouse-x new-mouse-x
        .mouse-y new-mouse-y
        .mouse-trail mouse-trail
        .mouse-trail-span |present<_opt _span Mouse-trail-origin> mouse-trail-span
        )

fn view
    .state state _state Mouse-trail-origin
    .htmls htmls _vec Htmls, _html Htmls, Modifiers, Chars
    .modifiers modifiers _vec Modifiers, _modifier event, Chars
    .chars chars _vec Chars, char
    :>
    .state _state Mouse-trail-origin
    .html _html Htmls, Modifiers, Chars
    .htmls _vec Htmls, _html Htmls, Modifiers, Chars
    .modifiers _vec Modifiers, _modifier event, Chars
    .chars _vec Chars, char
    >
    ? state [.count count .mouse-x mouse-x .mouse-y mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span]
    ? .vec chars .span |absent<_opt _span Chars> . [text]
    ? _vec-char-opt-span-add-str .. text .new "your mouse is at .x " [text]
    ? _u32-dup mouse-x [.a mouse-x .b mouse-x-use]
    ? _vec-char-opt-span-add-u32 .. text .new mouse-x-use [text]
    ? _vec-char-span-add-str .. text .new " .y " [text]
    ? _u32-dup mouse-y [.a mouse-y .b mouse-y-use]
    ? _vec-char-span-add-u32 .. text .new mouse-y-use [.vec chars .span text-span]
    ?
        _vec-add-array
        .vec htmls
        .new
            ; |text-dynamic<_html Htmls, Modifiers, Chars> |present<_opt _span Chars> text-span
            ; |text-static<_html Htmls, Modifiers, Chars> "hello"
    [.vec htmls .span div-subs]
    ?
        _vec-add-array
        .vec modifiers
        .new
            ; |style-static<_modifier event, Chars> .key "height" .value "100vh"
            ; |style-static<_modifier event, Chars> .key "width" .value "100vw"
            ;
                |on-mouse-move<_modifier event, Chars>
                [mouse-position .x u32 .y u32] |mouse-moved<event> mouse-position
    [.vec modifiers .span main-modifiers]
    .state (.count count .mouse-x mouse-x .mouse-y mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span)
    .html (
        |element<_html Htmls, Modifiers, Chars>
        .tag "main"
        .modifiers |present<_opt _span Modifiers> main-modifiers
        .subs |present<_opt _span Htmls> div-subs
        )
    .htmls htmls
    .modifiers modifiers
    .chars chars

ty html Htmls, Modifiers, Chars
    # for namespace, use xmlns attribute
    |element
        .tag str
        .modifiers _opt _span Modifiers
        .subs _opt _span Htmls
    |text-dynamic _opt _span Chars
    |text-static str

ty modifier Event, Chars
    |style-static .key str .value str
    |style-dynamic .key str .value _opt _span Chars
    |attribute-static .key str .value str
    |attribute-dynamic .key str .value _opt _span Chars
    |property .key str .value _modifier-property-value Chars
    |on-mouse-move _fn .x u32 .y u32, Event

ty modifier-property-value Chars
    |true .
    |false .
    |int i32
    |string _opt _span Chars

