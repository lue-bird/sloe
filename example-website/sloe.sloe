
ty State _mouse-trail-origin
    .count u32
    .mouse-x u32
    .mouse-y u32
    .mouse-trail (Vec _mouse-trail-origin, .x u32 .y u32)
    .mouse-trail-span Opt Span _mouse-trail-origin

ty event
    |counter-clicked .
    |mouse-moved .x u32 .y u32

fn initial-state mouse-trail-origin Origin _mouse-trail-origin :> State _mouse-trail-origin >
    .count 0 u32
    .mouse-x 0 u32
    .mouse-y 0 u32
    .mouse-trail _vec-empty<.x u32 .y u32> mouse-trail-origin
    .mouse-trail-span |no<Opt Span _mouse-trail-origin> .

fn update
    .state state State _mouse-trail-origin
    .event event event
    :> State _mouse-trail-origin >
    ? event
    [|counter-clicked .] (
        ? state [.count count .mouse-x old-mouse-x .mouse-y old-mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span]
        .count (_u32-add-clamp .a count .b 1 u32)
        .mouse-x old-mouse-x
        .mouse-y old-mouse-y
        .mouse-trail mouse-trail
        .mouse-trail-span mouse-trail-span
        )
    [|mouse-moved .x new-mouse-x .y new-mouse-y] (
        ? state [.count count .mouse-x old-mouse-x .mouse-y old-mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span]
        ?
            _vec-opt-span-add
            .vec mouse-trail
            .span mouse-trail-span
            .new (.x old-mouse-x .y old-mouse-y)
        [.vec mouse-trail .span mouse-trail-span]
        .count count
        .mouse-x new-mouse-x
        .mouse-y new-mouse-y
        .mouse-trail mouse-trail
        .mouse-trail-span _opt-yes mouse-trail-span
        )

fn view
    .state state State _mouse-trail-origin
    .htmls htmls Vec _htmls, Html _htmls, _modifiers, _chars
    .modifiers modifiers Vec _modifiers, Modifier event, _chars
    .chars chars Vec _chars, char
    :>
    .state State _mouse-trail-origin
    .html Html _htmls, _modifiers, _chars
    .htmls Vec _htmls, Html _htmls, _modifiers, _chars
    .modifiers Vec _modifiers, Modifier event, _chars
    .chars Vec _chars, char
    >
    ? state [.count count .mouse-x mouse-x .mouse-y mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span]
    ? .vec chars .span |no<Opt Span _chars> . [text]
    ? _vec-char-opt-span-add-str .. text .new "your mouse is at .x " [text]
    ? _u32-dup mouse-x [.a mouse-x .b mouse-x-use]
    ? _vec-char-opt-span-add-u32 .. text .new mouse-x-use [text]
    ? _vec-char-span-add-str .. text .new " .y " [text]
    ? _u32-dup mouse-y [.a mouse-y .b mouse-y-use]
    ? _vec-char-span-add-u32 .. text .new mouse-y-use [.vec chars .span text-span]
    ?
        _vec-add-array
        .vec htmls
        .new
            ; |text-dynamic<Html _htmls, _modifiers, _chars> _opt-yes text-span
            ; |text-static<Html _htmls, _modifiers, _chars> "hello"
    [.vec htmls .span div-subs]
    ?
        _vec-add-array
        .vec modifiers
        .new
            ; |style-static<Modifier event, _chars> .key "height" .value "100vh"
            ; |style-static<Modifier event, _chars> .key "width" .value "100vw"
            ;
                |on-mouse-move<Modifier event, _chars>
                [mouse-position .x u32 .y u32] |mouse-moved<event> mouse-position
    [.vec modifiers .span main-modifiers]
    .state (.count count .mouse-x mouse-x .mouse-y mouse-y .mouse-trail mouse-trail .mouse-trail-span mouse-trail-span)
    .html (
        |element<Html _htmls, _modifiers, _chars>
        .tag "main"
        .modifiers _opt-yes main-modifiers
        .subs _opt-yes div-subs
        )
    .htmls htmls
    .modifiers modifiers
    .chars chars

ty Html _htmls, _modifiers, _chars
    # for namespace, use xmlns attribute
    |element
        .tag str
        .modifiers Opt Span _modifiers
        .subs Opt Span _htmls
    |text-dynamic Opt Span _chars
    |text-static str

ty Modifier _event, _chars
    |style-static .key str .value str
    |style-dynamic .key str .value Opt Span _chars
    |attribute-static .key str .value str
    |attribute-dynamic .key str .value Opt Span _chars
    |property .key str .value Modifier-property-value _chars
    |on-mouse-move Fn .x u32 .y u32, _event

ty Modifier-property-value _chars
    |true .
    |false .
    |int i32
    |string Opt Span _chars

